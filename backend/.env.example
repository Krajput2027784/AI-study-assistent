DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=43200
MAX_MATERIAL_MB=50
MAX_VIDEO_MB=100
MAX_AUDIO_MB=50
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash
# true only if you test from a phone on the same Wi-Fi
ALLOW_LOCAL_NETWORK_CORS=false
FRONTEND_URL=http://localhost:3000

# Forgot-password emails (optional for local testing: without these, the reset link is
# printed in the backend terminal instead of being emailed).
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SMTP_FROM=your-email@gmail.com
PASSWORD_RESET_EXPIRE_MINUTES=30
